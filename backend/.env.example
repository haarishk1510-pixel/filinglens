# Required for AI-written answers. Create a key at https://platform.claude.com/
ANTHROPIC_API_KEY=

# The SEC requires automated clients to identify themselves.
SEC_USER_AGENT=FilingLens your-email@example.com

# Optional. A cheaper option is claude-haiku-5-5.
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium

# Free local model through Ollama. Set LLM_PROVIDER=anthropic to use Claude instead.
LLM_PROVIDER=local
LOCAL_LLM_MODEL=filinglens-llm
LOCAL_LLM_THINKING=true
